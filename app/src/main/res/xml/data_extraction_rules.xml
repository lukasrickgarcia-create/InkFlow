<?xml version="1.0" encoding="utf-8"?>
<!-- Nada é enviado para backup em nuvem automaticamente. O backup é manual (Ajustes > Exportar backup). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" />
        <include domain="database" />
        <include domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
